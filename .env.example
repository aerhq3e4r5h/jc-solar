# Copy to .env.local and fill in. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything
# else is read only by server code.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key is designed to be public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in (Supabase Auth > Providers > Google), used by supabase/config.toml locally
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Later phases (listed now so the full set is known) -----------------
# AI Solar Advisor. Server only; never expose to the browser.
# Key from https://aistudio.google.com/apikey. Model defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
# --- PayFast (server only) ----------------------------------------------
# PAYFAST_SANDBOX=true uses sandbox.payfast.co.za. Create a free sandbox
# account there and copy its Merchant ID, Merchant Key and the passphrase
# you set under Settings. For live, set PAYFAST_SANDBOX=false and use the
# details from your live PayFast account.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- EFT banking details printed on quotes and pro forma invoices --------
EFT_BANK_NAME=
EFT_ACCOUNT_NAME=
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=
EFT_ACCOUNT_TYPE=

# Courier (phase 4): provider to be chosen. Server only.
COURIER_PROVIDER=
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=
COURIER_SANDBOX=true
# Transactional email (order, payment and quote emails). Server only.
# Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=
# Bot protection on public forms (phase 9).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Analytics, loaded only after cookie consent (phase 9).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Error monitoring (phase 9).
SENTRY_DSN=
