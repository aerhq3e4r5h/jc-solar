# Copy to .env.local and fill in. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything
# else is read only by server code.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key is designed to be public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in (Supabase Auth > Providers > Google), used by supabase/config.toml locally
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Later phases (listed now so the full set is known) -----------------
# AI Solar Advisor (phase 6). Server only.
GEMINI_API_KEY=
GEMINI_MODEL=
# Payments (phase 3): gateway to be chosen. Server only.
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_KEY=
PAYMENT_PASSPHRASE=
PAYMENT_SANDBOX=true
# Courier (phase 4): provider to be chosen. Server only.
COURIER_PROVIDER=
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=
COURIER_SANDBOX=true
# Transactional email (phase 3). Server only.
RESEND_API_KEY=
EMAIL_FROM=
# Bot protection on public forms (phase 9).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Analytics, loaded only after cookie consent (phase 9).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Error monitoring (phase 9).
SENTRY_DSN=
